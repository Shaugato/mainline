{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://console.mainline.trappoint.org/contracts/1.0/permit.schema.json",
  "$comment": "The permit row as the console reads it. Licensing: permit.schema.json.license (REUSE sidecar).",
  "title": "MAINLINE console — permit",
  "description": "mainline.permit, ARCHITECTURE.md §5.5. Every counter below is a PROJECTION: a trigger wrote it onto the permit row from an authoritative table, and the six named CHECK constraints read those columns and nothing else. The console reads them verbatim and computes none of them (D5).",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "properties": {
        "data": { "$ref": "#/$defs/permit" }
      },
      "required": ["data"]
    }
  ],
  "$defs": {
    "gate_constraint": {
      "description": "One named refusal. The name IS the exhibit — 'the merge was refused by boundary_certified_when_issued' is a materially better sentence than 'a counter was non-zero'. `predicate` is the CHECK text as the catalog reports it; the console never paraphrases it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint", "counters", "blamed_by_refusal"],
      "properties": {
        "constraint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.$]*$"
        },
        "predicate": {
          "description": "Verbatim CHECK expression. Null when the read API did not capture it; the console then shows the constraint name alone rather than a reconstruction.",
          "type": ["string", "null"],
          "maxLength": 2048
        },
        "counters": {
          "description": "The projected columns this constraint reads. Empty for a constraint over non-counter columns (merge_evidence).",
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["column", "value"],
            "properties": {
              "column": { "type": "string", "minLength": 1, "maxLength": 64 },
              "value": { "$ref": "common.schema.json#/$defs/counter" }
            }
          }
        },
        "blamed_by_refusal": {
          "description": "True exactly when the refusal payload attached to this read names this constraint. It is a string comparison against the database's own word, never an evaluation of the predicate.",
          "type": "boolean"
        }
      }
    },
    "permit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permit_id",
        "site_id",
        "external_ref",
        "ref_name",
        "state",
        "head_seq",
        "gate_epoch",
        "under_hold",
        "opened_at",
        "horizon_at",
        "counters",
        "constraints"
      ],
      "properties": {
        "permit_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "site_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "site_code": { "type": ["string", "null"], "maxLength": 64 },
        "external_ref": {
          "description": "The customer's own work-order identifier, e.g. WO-88213.",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ref_name": {
          "description": "The protected branch this permit is a ref of.",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "parent_permit_id": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/uuid" }, { "type": "null" }]
        },
        "state": { "$ref": "common.schema.json#/$defs/subject_state" },
        "head_seq": { "type": "integer", "minimum": 0 },
        "gate_epoch": { "$ref": "common.schema.json#/$defs/gate_epoch" },
        "merged_commit": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/commit_id" }, { "type": "null" }]
        },
        "under_hold": { "type": "boolean" },
        "slice_digest": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/sha256_hex" }, { "type": "null" }]
        },
        "opened_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "horizon_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "counters": {
          "description": "The seven projected scalars the gate reads. P2: each is written by its own trigger from an authoritative table and RAISEs when that source is missing; none is ever supplied by a writer.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "open_blocking",
            "open_residue",
            "open_conflicts",
            "open_warrants",
            "unmodelled_asset_count",
            "unmet_floor_count",
            "countersigned_count"
          ],
          "properties": {
            "open_blocking": { "$ref": "common.schema.json#/$defs/counter" },
            "open_residue": { "$ref": "common.schema.json#/$defs/counter" },
            "open_conflicts": { "$ref": "common.schema.json#/$defs/counter" },
            "open_warrants": { "$ref": "common.schema.json#/$defs/counter" },
            "unmodelled_asset_count": { "$ref": "common.schema.json#/$defs/counter" },
            "unmet_floor_count": { "$ref": "common.schema.json#/$defs/counter" },
            "countersigned_count": { "$ref": "common.schema.json#/$defs/counter" }
          }
        },
        "constraints": {
          "description": "The named refusals declared on mainline.permit, in declaration order. Six gate constraints plus merge_evidence.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/gate_constraint" }
        },
        "boundary_certificate": {
          "description": "S11: an asset with no modelled energy edges is UNKNOWN, not SAFE — and unknown blocks. unmodelled_asset_count = tags_unmodelled + under_declared.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "asset_graph_version",
                "tags_declared",
                "tags_resolved",
                "tags_unmodelled",
                "under_declared",
                "computed_at"
              ],
              "properties": {
                "asset_graph_version": { "type": "string", "minLength": 1, "maxLength": 128 },
                "tags_declared": { "type": "integer", "minimum": 0 },
                "tags_resolved": { "type": "integer", "minimum": 0 },
                "tags_unmodelled": { "type": "integer", "minimum": 0 },
                "under_declared": { "type": "integer", "minimum": 0 },
                "computed_at": { "$ref": "common.schema.json#/$defs/timestamp" }
              }
            },
            { "type": "null" }
          ]
        },
        "merge_record": {
          "description": "Present only once the subject has merged. Its (subject_id, gate_epoch) composite FK is the epoch pin: while this row exists the database refuses any UPDATE that moves gate_epoch, so a new obligation cannot be attached to an issued permit.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["gate_epoch", "merged_at", "merged_by", "merged_commit", "clearance_digest"],
              "properties": {
                "gate_epoch": { "$ref": "common.schema.json#/$defs/gate_epoch" },
                "merged_at": { "$ref": "common.schema.json#/$defs/timestamp" },
                "merged_by": { "type": "string", "minLength": 1, "maxLength": 128 },
                "merged_commit": { "$ref": "common.schema.json#/$defs/commit_id" },
                "clearance_digest": { "$ref": "common.schema.json#/$defs/sha256_hex" },
                "checkpoint_tree_size": { "type": ["integer", "null"], "minimum": 0 }
              }
            },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
