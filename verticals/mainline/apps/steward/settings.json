{
  "model": "opus",
  "permissions": {
    "defaultMode": "default",
    "disableAutoMode": true,
    "allow": [
      "MCP(crdb.list_databases)",
      "MCP(crdb.list_tables)",
      "MCP(crdb.get_table_schema)",
      "MCP(crdb.select_query)",
      "MCP(crdb.explain_query)",
      "MCP(crdb.show_statement)",
      "MCP(crdb.show_running_queries)",
      "MCP(crdb.insert_rows)",
      "mcp__crdb__list_databases",
      "mcp__crdb__list_tables",
      "mcp__crdb__get_table_schema",
      "mcp__crdb__select_query",
      "mcp__crdb__explain_query",
      "mcp__crdb__show_statement",
      "mcp__crdb__show_running_queries",
      "mcp__crdb__insert_rows",
      "Read(/opt/steward/app/**)",
      "Read(/opt/steward/skills/**)"
    ],
    "deny": [
      "MCP(crdb.create_database)",
      "MCP(crdb.create_table)",
      "mcp__crdb__create_database",
      "mcp__crdb__create_table",
      "Bash",
      "PowerShell",
      "Write",
      "Edit",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Task",
      "Artifact",
      "Read(/opt/steward/run/**)",
      "Read(/opt/steward/state/**)",
      "Read(~/.claude.json)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "disableAllHooks": true,
  "disableSkillShellExecution": true,
  "disableBundledSkills": true,
  "disableWorkflows": true,
  "disableArtifact": true,
  "disableRemoteControl": true,
  "disableAgentView": true,
  "disableDeepLinkRegistration": true,
  "disableBrowserExternalNavigation": true,
  "autoMemoryEnabled": false,
  "includeCoAuthoredBy": false,
  "cleanupPeriodDays": 1,
  "spinnerTipsEnabled": false,
  "autoUpdatesChannel": "stable",
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "MCP_DISCOVERY_CACHE": "0"
  }
}
