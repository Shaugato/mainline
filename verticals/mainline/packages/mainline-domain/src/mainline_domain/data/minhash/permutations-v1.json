{
  "minhash_version": 1,
  "_comment": [
    "COMMITTED EVIDENCE, NOT CONFIGURATION.  Decision D3 in docs/leads/algorithms.md.",
    "This table fixes the 128 affine permutations that turn per-shingle blake2b-64 base",
    "hashes into a MinHash signature.  It is committed rather than seeded so that a",
    "signature computed today can be re-derived from these exact bytes years from now,",
    "in any language, by anyone -- including an opposing expert.",
    "Editing any number here changes every band_hash in mainline.clause_band and",
    "therefore changes which ancestor clauses are ever compared.  That is a MIGRATION,",
    "not a config change: bump minhash_version, ship a new file, and rebuild the bands."
  ],
  "algorithm": "shingle canon_text into character 5-grams; h = int(blake2b(shingle, digest_size=8, person='mainline-mh1'), 'big') mod p; signature[i] = min over shingles of (a_i*h + b_i) mod p; band j hash = blake2b over the concatenated 8-byte big-endian minima of rows [j*8, j*8+8), digest_size=8, person='mainline-band1', read as a signed INT8",
  "prime": 2305843009213693951,
  "prime_expression": "2**61 - 1 (Mersenne prime; every value fits 8 bytes big-endian)",
  "n_perms": 128,
  "bands": 16,
  "rows_per_band": 8,
  "shingle_size": 5,
  "band_knee_jaccard": 0.7071067811865476,
  "base_hash": {
    "function": "blake2b",
    "digest_size": 8,
    "person": "mainline-mh1",
    "byteorder": "big",
    "reduction": "mod prime"
  },
  "band_hash": {
    "function": "blake2b",
    "digest_size": 8,
    "person": "mainline-band1",
    "member_encoding": "8-byte big-endian per signature minimum, concatenated in row order",
    "fold": "int.from_bytes(digest, 'big', signed=True) -> CockroachDB INT8"
  },
  "derivation": {
    "scheme": "blake2b-kdf-v1",
    "a": "1 + (int(blake2b(b'mainline/minhash/v1/a/<i>', digest_size=16, person='mainline-mhkdf1'), 'big') mod (prime - 1))",
    "b": "int(blake2b(b'mainline/minhash/v1/b/<i>', digest_size=16, person='mainline-mhkdf1'), 'big') mod prime",
    "note": "<i> is the decimal permutation index with no padding.  a is shifted into [1, p-1] because a = 0 collapses the permutation to a constant.  load_params(verify=True) re-runs this recipe and refuses the file if any coefficient disagrees."
  },
